# Nome exato da impressora (opcional)
# Se não preencher, usará a impressora padrão do Windows
PRINTER_NAME=

# Intervalo de verificação em milissegundos (opcional)
# Tempo entre verificações de jobs na tabela
POLL_MS=5000

# ID do agente (opcional)
# Identificador único do agente de impressão
AGENT_ID=PRINT-AGENT-01

# Configurações de impressão (novas)
# Apenas pedidos PIX pagos são impressos
# Outros métodos (dinheiro, cartão, etc) passam livres sem impressão
PRINT_ONLY_PAID_PIX=true

# Timeout de impressão em segundos (opcional)
PRINT_TIMEOUT=30
